config_version=5

[application]

config/name="workshop-final-project"
run/main_scene="uid://bx8324ifw78le"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"

[autoload]

Global="*uid://c6tmkmlfsm4xn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://cyib88ipt7ins"

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Scenes/": "yellow",
"res://Scenes/Enemies/": "orange",
"res://Scenes/Enemies/base/": "teal",
"res://Scenes/Enemies/basic/": "yellow",
"res://Scenes/Enemies/patrolling/": "yellow",
"res://Scenes/Platforms/": "orange"
}

